<Window
    x:Class="CloudStorages.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="Cloud Storages">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="30" Height="30" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE753;" Foreground="White" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1" Text="Cloud Storages" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
            <Button Grid.Column="2" Content="⚙" Click="Settings_Click" Style="{StaticResource DefaultButtonStyle}" />
        </Grid>

        <muxc:NavigationView Grid.Row="1" x:Name="Nav" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="Nav_SelectionChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Overview" Tag="overview" Icon="Home" />
                <muxc:NavigationViewItem Content="Cloud Drives" Tag="drives" Icon="HardDrive" />
                <muxc:NavigationViewItem Content="Connections" Tag="connections" Icon="Contact" />
                <muxc:NavigationViewItem Content="Activity" Tag="activity" Icon="Clock" />
            </muxc:NavigationView.MenuItems>

            <Grid Padding="26,12,26,26">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1200">
                        <TextBlock Text="Your cloud storage" FontSize="32" FontWeight="SemiBold" />
                        <TextBlock Text="Cloud drives that appear in This PC like local storage." Opacity="0.7" FontSize="15" Margin="0,5,0,22" />

                        <InfoBar x:Name="StatusBar" IsOpen="True" Severity="Informational" Title="Explorer integration" Message="Drive integration is prepared for the native Windows filesystem engine." Margin="0,0,0,18" />

                        <Grid ColumnSpacing="0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel x:Name="LeftCards" Grid.Column="0" />
                            <StackPanel x:Name="RightCards" Grid.Column="1" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </muxc:NavigationView>
    </Grid>
</Window>
